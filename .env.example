# Copy to .env and fill in. NEVER commit the real file.
#   set -a; source .env; set +a

# Create the key at OKX -> Account -> API. Permissions: "Trade" ONLY.
# Do NOT enable "Withdraw". Bind the key to your VPS's public IP.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Everything runs against OKX's demo (paper) environment unless this is set to
# the exact phrase below. Any other value -- including "true" or "1" -- keeps
# you on paper.
# OKX_LIVE_TRADING=i-understand-the-risk

# Refuse every write at the transport, whatever environment is targeted.
# Independent of OKX_LIVE_TRADING on purpose: "point at the real account and
# look, but never place an order" is a legitimate thing to want, and useful for
# verifying credentials against live before a demo key exists.
# It cannot test order placement, sizing or TP/SL attachment -- nothing reads
# can reach those -- so it complements the demo environment, it does not
# replace it.
# OKX_READ_ONLY=1

# Optional: alerts from `sync` when it runs unattended from cron.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
